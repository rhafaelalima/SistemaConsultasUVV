@model IEnumerable<SistemaConsultasUVV.Models.Consulta>
@{ ViewData["Title"] = "Minhas Consultas"; }

<h2>Minhas Consultas</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Agendar Nova Consulta</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Médico</th>
            <th>Especialidade</th>
            <th>Data e Hora</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Medico</td>
            <td>@item.Especialidade</td>
            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Status</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir esta consulta?');">
                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>