@model SistemaConsultasUVV.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Criar Conta"; }

<h2>Criar Conta</h2>

<form asp-action="Register" method="post">
    <!-- Exibe alertas gerais do controller, como "E-mail já cadastrado." -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label class="form-label">Nome <span class="text-danger">*</span></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">E-mail <span class="text-danger">*</span></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Senha <span class="text-danger">*</span></label>
        <input asp-for="Senha" class="form-control" type="password" placeholder="Mínimo 6 caracteres" />
        <span asp-validation-for="Senha" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Cadastrar</button>
</form>